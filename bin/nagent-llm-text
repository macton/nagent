#!/usr/bin/python3

import argparse
import sys
from pathlib import Path

HELPERS_DIR = Path(__file__).resolve().parent / "helpers"
sys.path.insert(0, str(HELPERS_DIR))
from nagent_llm import add_llm_arguments, generate_text_with_usage, resolve_from_args
from nagent_cli import emit_json, exit_on_description

NAGENT_LLM_TEXT_DESCRIPTION = """\
Send the contents of a text file to the configured LLM and print the response.
Use for one-shot text generation outside the nagent conversation loop, or when
another tool (including nagent itself) needs to forward a file as an LLM message."""


def main() -> None:
    exit_on_description(NAGENT_LLM_TEXT_DESCRIPTION)

    parser = argparse.ArgumentParser(
        description=(
            "Send text to an LLM and print the response. "
            "Loads provider and model from ~/.nagent/config.json (or NAGENT_CONFIG) when present."
        ),
    )
    parser.add_argument(
        "--file",
        required=True,
        help="Path to a text file whose contents are sent as the message.",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Print structured JSON output instead of plain text.",
    )
    add_llm_arguments(parser)
    args = parser.parse_args()

    path = Path(args.file)
    if not path.is_file():
        print(f"Error: file not found: {path}", file=sys.stderr)
        sys.exit(1)

    provider, model = resolve_from_args(args)
    message = path.read_text(encoding="utf-8")

    try:
        result = generate_text_with_usage(message, provider, model)
    except Exception as exc:
        print(f"Error: {exc}", file=sys.stderr)
        sys.exit(1)

    if args.json:
        emit_json(
            {
                "file": str(path.resolve()),
                "provider": provider,
                "model": model,
                "response": result.text,
                "input_tokens": result.input_tokens,
                "output_tokens": result.output_tokens,
            }
        )
    else:
        print(result.text)


if __name__ == "__main__":
    main()
