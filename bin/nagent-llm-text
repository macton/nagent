#!/usr/bin/python3

import argparse
import sys
from pathlib import Path

HELPERS_DIR = Path(__file__).resolve().parent / "helpers"
sys.path.insert(0, str(HELPERS_DIR))
from nagent_llm import add_llm_arguments, generate_text, resolve_from_args


def main() -> None:
    parser = argparse.ArgumentParser(
        description=(
            "Send text to an LLM and print the response. "
            "Loads provider and model from ~/.nagent/config.json (or NAGENT_CONFIG) when present."
        ),
    )
    parser.add_argument(
        "--file",
        required=True,
        help="Path to a text file whose contents are sent as the message.",
    )
    add_llm_arguments(parser)
    args = parser.parse_args()

    path = Path(args.file)
    if not path.is_file():
        print(f"Error: file not found: {path}", file=sys.stderr)
        sys.exit(1)

    provider, model = resolve_from_args(args)
    message = path.read_text(encoding="utf-8")

    try:
        print(generate_text(message, provider, model))
    except Exception as exc:
        print(f"Error: {exc}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
