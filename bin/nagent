NAGENT_DESCRIPTION = """\
Structured conversation orchestrator for terminal workflows.
Use as the main entry point when coordinating multi-step tasks: it maintains a
conversation, calls the configured LLM, parses structured tags, and can read
and write files, run shell commands, continue reasoning, and delegate work to
sub-conversations. Prefer nagent for human-driven requests and scoped
sub-conversation tasks."""

Invocation = Literal["user", "delegated"]
TagType = Literal["response", "read", "file_read", "file_patch", "write", "shell", "next", "conversation"]

# Protocol tag names -> NagentTag.kind. Shapes are validated in parse_response;
# tokenization lives in nagent_tags (the protocol is XML-ish, not XML: bodies
# are raw text, so a strict XML parser would reject valid output).
TAG_KINDS: dict[str, TagType] = {
    "nagent-response": "response",
    "nagent-read": "read",
    "nagent-file-read": "file_read",
    "nagent-file-patch": "file_patch",
    "nagent-write": "write",
    "nagent-shell": "shell",
    "nagent-next": "next",
    "nagent-conversation": "conversation",
}

READ_SPLIT_THRESHOLD_BYTES = 64 * 1024
NAGENT_FILE_SPLIT = Path(__file__).resolve().parent / "nagent-file-split"
NAGENT_FILE_SUMMARIZE = Path(__file__).resolve().parent / "nagent-file-summarize"
SAVED_CONVERSATION_SUMMARY_WORD_COUNT = 50
MAX_FORMAT_RETRIES = 3
NAGENT_LLM_TEXT = Path(__file__).resolve().parent / "nagent-llm-text"
COMPACT_PROMPT_PATH = Path(__file__).resolve().parent.parent / "prompts" / "compact-conversation.md"
INTERRUPTED_MESSAGE = "Interrupted..."
FILE_HISTORY_COMMIT_LIMIT = 50
_spinner_enabled = True

# Whole-output wrappers that may accidentally be nested inside
# <nagent-response>.  These are internal protocol details and should not be
# printed to the human user.
USER_VISIBLE_WRAPPER_NAMES = ("nagent-response", "agent-response")

MARKDOWN_FENCE_PATTERN = re.compile(r"\A\s*```[^\n`]*\n(.*?)\n```\s*\Z", re.DOTALL)
INITIAL_CONTEXT_BLOCK = "initial_context"
NAGENT_PREAMBLE = "You are nagent, a structured conversation loop."


@dataclass
class NagentTag:
    kind: TagType
    content: str
    path: str | None = None
    conversation_file: str | None = None
    conversation_name: str | None = None


@dataclass
class LlmSettings:
    provider: str
    model: str
    config_path: Path | None = None


@dataclass
class TokenStats:
    turn_count: int = 0
    conversation_input_tokens: int = 0
    recursive_input_tokens: int = 0
    recursive_output_tokens: int = 0

    def status_line(self) -> str:
        return (
            f"[Turns:{self.turn_count} "
            f"Conversation-Tokens:{self.conversation_input_tokens} "
            f"Tokens-In:{self.recursive_input_tokens} "
            f"Tokens-Out:{self.recursive_output_tokens}]"
        )

    def add_llm_turn(self, input_tokens: int, output_tokens: int) -> None:
        self.turn_count += 1
        self.conversation_input_tokens = input_tokens
        self.recursive_input_tokens += input_tokens
        self.recursive_output_tokens += output_tokens

    def add_recursive(self, input_tokens: int, output_tokens: int) -> None:
        self.recursive_input_tokens += input_tokens
        self.recursive_output_tokens += output_tokens

    def as_dict(self) -> dict[str, int]:
        return {
            "turn_count": self.turn_count,
            "conversation_input_tokens": self.conversation_input_tokens,
            "recursive_input_tokens": self.recursive_input_tokens,
            "recursive_output_tokens": self.recursive_output_tokens,
        }


def set_spinner_enabled(enabled: bool) -> None:
    global _spinner_enabled
    _spinner_enabled = enabled


def wait_spinner(message: str) -> WaitSpinner:
    return WaitSpinner(message, enabled=_spinner_enabled)


def host_uname() -> str:
    result = subprocess.run(
        ["uname", "-a"],
        capture_output=True,
        text=True,
    )
    if result.returncode == 0:
        return result.stdout.strip()
    return result.stderr.strip() or "unknown"


def git_repo_context(cwd: Path | None = None) -> str:
    workdir = cwd or Path.cwd()
    toplevel = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        cwd=workdir,
    )
    if toplevel.returncode != 0:
        return ""

    remotes = subprocess.run(
        ["git", "remote", "-v"],
        capture_output=True,
        text=True,
        cwd=workdir,
    )
    remote_lines = remotes.stdout.strip() if remotes.returncode == 0 and remotes.stdout.strip() else "(none)"
    remote_block = "\n".join(f"  {line}" for line in remote_lines.splitlines())

    project_root = toplevel.stdout.strip()
    return f"- git toplevel/project-root: {project_root}\n- git remote -v:\n{remote_block}"


def large_file_guidance() -> str:
    threshold_kb = READ_SPLIT_THRESHOLD_BYTES // 1024
    return f"""Large files (>{threshold_kb}KB):
- Use <nagent-file-read path="..."/> instead of <nagent-read>; it auto-splits large files.
- Edit the segment files listed in the returned index.json.
- Merge edits back with <nagent-file-patch index="{{index-path}}"/>."""


def file_edit_rules(file_edit_path: Path | None) -> str:
    if file_edit_path is not None:
        return f"""File editing (this session):
- You may use <nagent-write> on this file: {file_edit_path}
- You may also write segment files from a split of this file (via <nagent-file-read>).
- Merge segment edits with <nagent-file-patch index="{{index-path}}"/>.
- Do not use shell commands to write files; use <nagent-write> for edits.
{large_file_guidance()}"""

    return f"""File editing:
- Do not use shell commands to write files outside temp directories (/tmp, /var/tmp, or $TMPDIR).
- To edit project files, use nagent-file-edit; <nagent-write> is allowed only under temp directories.
{large_file_guidance()}"""


def parse_context_yaml_paths(content: str) -> list[str]:
    try:
        import yaml  # type: ignore[import-not-found]

        loaded = yaml.safe_load(content)
        if isinstance(loaded, list):
            return [str(item) for item in loaded if item is not None]
        if isinstance(loaded, dict) and isinstance(loaded.get("paths"), list):
            return [str(item) for item in loaded["paths"] if item is not None]
    except ImportError:
        pass
    except Exception:
        return []

    paths: list[str] = []
    for line in content.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or stripped in ("---", "..."):
            continue
        if stripped.endswith(":"):
            continue
        if stripped.startswith("-"):
            stripped = stripped[1:].strip()
        if not stripped or stripped.startswith("#"):
            continue
        if " #" in stripped:
            stripped = stripped.split(" #", 1)[0].rstrip()
        if len(stripped) >= 2 and stripped[0] == stripped[-1] and stripped[0] in ("'", '"'):
            stripped = stripped[1:-1]
        if stripped:
            paths.append(stripped)
    return paths


def load_context_path(root: Path, path: Path, seen: set[Path]) -> str:
    resolved = path if path.is_absolute() else root / path
    try:
        resolved = resolved.resolve()
    except OSError:
        return ""
    if resolved in seen or not resolved.is_file():
        return ""
    seen.add(resolved)

    try:
        content = resolved.read_text(encoding="utf-8")
    except OSError:
        return ""

    if resolved.name == "context.yaml":
        parts = [
            load_context_path(root, Path(child), seen)
            for child in parse_context_yaml_paths(content)
        ]
        return "\n".join(part for part in parts if part)
    return content


def load_context_file(path: Path) -> str:
    if not path.is_file():
        return ""
    try:
        return path.read_text(encoding="utf-8").strip()
    except OSError:
        return ""


def load_root_context(root: Path) -> str:
    yaml_context = root / "context.yaml"
    markdown_context = root / "context.md"
    seen: set[Path] = set()
    if yaml_context.is_file():
        return load_context_path(root, yaml_context, seen).strip()
    if markdown_context.is_file():
        return load_context_path(root, markdown_context, seen).strip()
    return ""


def _run_git(cwd: Path, args: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", *args],
        cwd=cwd,
        capture_output=True,
        text=True,
    )


def git_toplevel_for_path(path: Path) -> Path | None:
    workdir = path.parent if path.is_file() else path
    result = _run_git(workdir, ["rev-parse", "--show-toplevel"])
    if result.returncode != 0:
        return None
    return Path(result.stdout.strip())


def git_relative_path(repo_root: Path, path: Path) -> str:
    try:
        return str(path.resolve().relative_to(repo_root.resolve()))
    except ValueError:
        result = _run_git(repo_root, ["ls-files", "--full-name", "--", str(path)])
        if result.returncode == 0 and result.stdout.strip():
            return result.stdout.strip().splitlines()[0]
    return str(path.resolve())


def parse_existing_file_history(context: str | None) -> dict[str, str]:
    if not context:
        return {}
    match = re.search(r"\{file-history\}(.*?)\{/file-history\}", context, re.DOTALL)
    if match is None:
        return {}
    summaries: dict[str, str] = {}
    for line in match.group(1).splitlines():
        commit_match = re.match(r"- ([0-9a-f]{40}) \([0-9a-f]+\):\s*(.*)", line.strip())
        if commit_match:
            summaries[commit_match.group(1)] = commit_match.group(2).strip()
    return summaries


def parse_existing_file_summary(context: str | None) -> str | None:
    if not context:
        return None
    match = re.search(r"\{file-summary\}(.*?)\{/file-summary\}", context, re.DOTALL)
    if match is None:
        return None
    body = match.group(1).strip()
    if "\n\n" in body:
        return body.split("\n\n", 1)[1].strip()
    return body


def git_file_history(repo_root: Path, rel_path: str) -> list[dict[str, str]]:
    result = _run_git(
        repo_root,
        [
            "log",
            "--follow",
            f"--max-count={FILE_HISTORY_COMMIT_LIMIT}",
            "--date=short",
            "--format=%H%x1f%h%x1f%ad%x1f%an%x1f%ae%x1f%s",
            "--",
            rel_path,
        ],
    )
    if result.returncode != 0 or not result.stdout.strip():
        return []

    commits: list[dict[str, str]] = []
    for line in result.stdout.splitlines():
        parts = line.split("\x1f")
        if len(parts) != 6:
            continue
        full_hash, short_hash, date, author, email, subject = parts
        commits.append(
            {
                "hash": full_hash,
                "short": short_hash,
                "date": date,
                "author": author,
                "email": email,
                "subject": subject,
            }
        )
    return commits


def git_commit_files(repo_root: Path, commit_hash: str) -> list[str]:
    result = _run_git(repo_root, ["diff-tree", "--no-commit-id", "--name-only", "-r", "--root", commit_hash])
    if result.returncode != 0:
        return []
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def git_commit_file_patch(repo_root: Path, commit_hash: str, rel_path: str) -> str:
    result = _run_git(
        repo_root,
        [
            "show",
            "--find-renames",
            "--format=%B",
            "--stat",
            "--patch",
            commit_hash,
            "--",
            rel_path,
        ],
    )
    if result.returncode != 0 or not result.stdout.strip():
        fallback = _run_git(repo_root, ["show", "--format=%B", "--stat", "--patch", "--find-renames", commit_hash])
        if fallback.returncode != 0:
            return ""
        return fallback.stdout[:12000]
    return result.stdout[:12000]


def parse_llm_summary_json(text: str) -> dict[str, str]:
    stripped = text.strip()
    fence = re.match(r"```(?:json)?\s*(.*?)\s*```", stripped, re.DOTALL)
    if fence:
        stripped = fence.group(1).strip()
    payload = json.loads(stripped)
    if isinstance(payload, dict) and isinstance(payload.get("summaries"), list):
        rows = payload["summaries"]
    elif isinstance(payload, list):
        rows = payload
    else:
        rows = []
    summaries: dict[str, str] = {}
    for row in rows:
        if not isinstance(row, dict):
            continue
        commit = row.get("commit")
        summary = row.get("summary")
        if isinstance(commit, str) and isinstance(summary, str):
            summaries[commit] = " ".join(summary.split())
    return summaries


def summarize_new_file_commits(
    repo_root: Path,
    rel_path: str,
    commits: list[dict[str, str]],
    provider: str,
    model: str,
) -> dict[str, str]:
    if not commits:
        return {}

    sections: list[str] = []
    total_size = 0
    for commit in commits:
        patch = git_commit_file_patch(repo_root, commit["hash"], rel_path)
        section = (
            f"Commit: {commit['hash']}\n"
            f"Date: {commit['date']}\n"
            f"Author: {commit['author']} <{commit['email']}>\n"
            f"Subject: {commit['subject']}\n"
            f"Relevant diff/stat:\n{patch}\n"
        )
        if total_size + len(section) > 60000:
            section = section[: max(0, 60000 - total_size)]
        sections.append(section)
        total_size += len(section)
        if total_size >= 60000:
            break

    prompt = (
        "Summarize each git commit's effect on the target file in one short sentence. "
        "Return only JSON in this form: "
        '{"summaries":[{"commit":"<full commit hash>","summary":"<short summary>"}]}.\n'
        f"Target file: {rel_path}\n\n"
        + "\n---\n".join(sections)
    )
    try:
        return parse_llm_summary_json(generate_text(prompt, provider, model))
    except Exception:
        return {}


def coedited_file_rows(repo_root: Path, rel_path: str, commits: list[dict[str, str]]) -> list[tuple[str, int, str]]:
    counts: dict[str, int] = {}
    for commit in commits:
        for changed in git_commit_files(repo_root, commit["hash"]):
            if changed == rel_path:
                continue
            counts[changed] = counts.get(changed, 0) + 1

    total = max(1, len(commits))
    rows: list[tuple[str, int, str]] = []
    for changed, count in sorted(counts.items(), key=lambda item: (-item[1], item[0]))[:20]:
        ratio = count / total
        if ratio >= 0.5:
            likelihood = "high"
        elif ratio >= 0.2:
            likelihood = "medium"
        else:
            likelihood = "low"
        rows.append((changed, count, f"{likelihood} ({round(ratio * 100)}%)"))
    return rows


def format_file_history(
    repo_root: Path,
    rel_path: str,
    commits: list[dict[str, str]],
    summaries: dict[str, str],
) -> str:
    people: dict[str, int] = {}
    for commit in commits:
        label = f"{commit['author']} <{commit['email']}>"
        people[label] = people.get(label, 0) + 1

    lines = [
        "{file-history}",
        f"File: {rel_path}",
        f"Repository: {repo_root}",
        "",
        "Individuals who edited this file:",
    ]
    for person, count in sorted(people.items(), key=lambda item: (-item[1], item[0])):
        lines.append(f"- {person}: {count} commit{'s' if count != 1 else ''}")

    lines.extend(["", "Step-by-step history:"])
    for commit in reversed(commits):
        summary = summaries.get(commit["hash"]) or commit["subject"]
        lines.append(f"- {commit['date']} {commit['short']} {commit['author']}: {summary}")

    lines.extend(["", "Files edited in the same commits:"])
    coedited = coedited_file_rows(repo_root, rel_path, commits)
    if coedited:
        lines.extend(["| file | commits together | historical co-edit rate |", "| --- | ---: | --- |"])
        for changed, count, likelihood in coedited:
            lines.append(f"| {changed} | {count} | {likelihood} |")
        lines.extend(
            [
                "",
                "Use these files as hints. Before editing, inspect high-likelihood co-edited files "
                "when the requested change may affect interfaces, tests, config, or paired code. "
                "Do not edit them unless the user request or evidence requires it.",
            ]
        )
    else:
        lines.append("- None found.")

    lines.extend(["", "Summarized commits:"])
    for commit in commits:
        summary = summaries.get(commit["hash"]) or commit["subject"]
        lines.append(f"- {commit['hash']} ({commit['short']}): {summary}")
    lines.append("{/file-history}")
    return "\n".join(lines)


def run_file_summary(path: Path, provider: str, model: str, config_path: Path | None) -> str:
    command = [
        str(NAGENT_FILE_SUMMARIZE),
        "--file",
        str(path),
        "--provider",
        provider,
        "--model",
        model,
        "--json",
    ]
    if config_path is not None:
        command.extend(["--config", str(config_path.expanduser())])

    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode != 0:
        error = result.stderr.strip() or result.stdout.strip() or "nagent-file-summarize failed"
        return f"Unavailable: {error}"
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError:
        return result.stdout.strip()
    summary = payload.get("summary")
    return summary.strip() if isinstance(summary, str) else ""


def file_edit_history_and_summary_block(
    file_edit_path: Path,
    provider: str | None,
    model: str | None,
    config_path: Path | None,
    previous_initial_context: str | None,
) -> str:
    if provider is None or model is None:
        return ""

    repo_root = git_toplevel_for_path(file_edit_path)
    existing_commit_summaries = parse_existing_file_history(previous_initial_context)
    existing_summary = parse_existing_file_summary(previous_initial_context)
    file_summary = existing_summary
    file_history = ""
    new_commits: list[dict[str, str]] = []

    if repo_root is not None:
        rel_path = git_relative_path(repo_root, file_edit_path)
        commits = git_file_history(repo_root, rel_path)
        new_commits = [commit for commit in commits if commit["hash"] not in existing_commit_summaries]
        new_summaries = summarize_new_file_commits(repo_root, rel_path, new_commits, provider, model)
        summaries = dict(existing_commit_summaries)
        for commit in new_commits:
            summaries[commit["hash"]] = new_summaries.get(commit["hash"], commit["subject"])
        file_history = format_file_history(repo_root, rel_path, commits, summaries) if commits else ""

    if file_summary is None or new_commits:
        file_summary = run_file_summary(file_edit_path, provider, model, config_path)

    summary_block = "\n".join(
        [
            "{file-summary}",
            f"File: {file_edit_path}",
            "Source: nagent-file-summarize",
            "",
            file_summary or "No summary available.",
            "{/file-summary}",
        ]
    )
    return "\n\n".join(part for part in (file_history, summary_block) if part)


def build_initial_context(
    root: Path,
    process_path: Path,
    invocation: Invocation,
    conversation_name: str,
    parent_conversation: str | None = None,
    file_edit_path: Path | None = None,
    file_edit_id: str | None = None,
    provider: str | None = None,
    model: str | None = None,
    config_path: Path | None = None,
    previous_initial_context: str | None = None,
) -> str:
    parent = parent_conversation or "none"
    if invocation == "user":
        response_hint = "Use <nagent-response> to communicate with the human user."
        role_instructions = """User invocation:
- A human started this nagent instance from the command line.
- Use <nagent-response> for human-facing replies.
- Coordinate the overall request; delegate execution and research."""
    else:
        response_hint = "Use <nagent-response> to return your final result to the parent nagent."
        role_instructions = """Delegated invocation:
- A parent nagent conversation spawned you for one scoped task (see <user-prompt>).
- Use <nagent-response> for your final result to the parent—concise and structured, not conversational.
- Still decompose and delegate when your scoped task is itself complex."""

    git_context = git_repo_context()
    git_section = f"\n{git_context}" if git_context else ""
    tools_section = collect_bin_tool_descriptions(process_path.parent)
    tools_block = f"\n\n{tools_section}" if tools_section else ""
    # Install context ships with the nagent folder itself (context.yaml or
    # context.md next to bin/); it is injected before the per-root context so
    # root context can override or extend it.
    install_context = load_root_context(process_path.resolve().parent.parent)
    install_context_block = f"\n{install_context}\n" if install_context else ""
    root_context = load_root_context(root)
    root_context_block = f"\n{root_context}\n" if root_context else ""
    if file_edit_path is not None:
        write_hint = "Use <nagent-write> according to the File editing (this session) rules above."
    else:
        write_hint = (
            "Use <nagent-write> for temp files only; use nagent-file-edit for project files."
        )
    file_edit_block = ""
    file_edit_detail_block = ""
    if file_edit_path is not None:
        file_edit_block = f"\n- file id: {file_edit_id or 'unknown'}"
        file_edit_block += f"\n- file-edit target: {file_edit_path}"
        file_edit_details = file_edit_history_and_summary_block(
            file_edit_path,
            provider,
            model,
            config_path,
            previous_initial_context,
        )
        if file_edit_details:
            file_edit_detail_block = f"\n{file_edit_details}\n"
        file_knowledge = load_context_file(file_knowledge_path(root, file_edit_id)) if file_edit_id else ""
        if file_knowledge:
            file_edit_detail_block += f"\n{{file-knowledge}}\n{file_knowledge}\n{{/file-knowledge}}\n"

    knowledge_digest = load_context_file(digest_path(root))
    knowledge_block = f"\n{{knowledge}}\n{knowledge_digest}\n{{/knowledge}}\n" if knowledge_digest else ""

    return f"""<initial_context>
{NAGENT_PREAMBLE}

Respond only with one or more of these structured tags (no other text):
- <nagent-response>{{text to respond to user}}</nagent-response>
- <nagent-read path="{{file-path-to-read}}" />
- <nagent-file-read path="{{file-path-to-read}}" />
- <nagent-file-patch index="{{index-json-path}}" />
- <nagent-write path="{{file-path-to-write}}">{{file content}}</nagent-write>
- <nagent-shell>{{shell commands}}</nagent-shell>
- <nagent-next>{{prompt}}</nagent-next>
- <nagent-conversation>{{prompt}}</nagent-conversation>
- <nagent-conversation conversation-file="{{path-to-conversation-file}}">{{prompt}}</nagent-conversation>
- <nagent-conversation conversation-name="{{saved-conversation-name}}">{{prompt}}</nagent-conversation>

Instance:
- invocation: {invocation}
- conversation: {conversation_name}
- parent conversation: {parent}{file_edit_block}

Environment:
- nagent root: {root}
- nagent process: {process_path}
- cwd: {Path.cwd()}
- host (uname -a): {host_uname()}{git_section}{tools_block}

Context management (every nagent conversation, including sub-conversations):
- Each nagent instance has its own private conversation file; parent and child conversations do not share context.
- At every level, decompose complex or multistep work instead of doing it in one turn.
- Spawn sub-conversations with <nagent-conversation> when work is:
  - standalone and well-defined (specific edit, isolated fix, known command sequence)
  - exploratory (filesystem probes, diagnostics, iterative shell work)
  - research-heavy (many files, codebase search, comparing options)
  - likely to produce large output (long logs, big reads) that would bloat your thread
- Keep in your own conversation only coordination, decisions, and small direct steps for your assigned task.
- Start each sub-conversation a self-contained prompt with goal, constraints, paths, and the result format you need back.

{file_edit_rules(file_edit_path)}

{response_hint}
Use <nagent-read> for small files; use <nagent-file-read> when the file may exceed {READ_SPLIT_THRESHOLD_BYTES // 1024}KB.
{write_hint}
Use <nagent-shell> for other commands; output will be appended to your conversation.
Use <nagent-next> to continue reasoning with an appended prompt.
Use <nagent-conversation> to delegate a sub-task to a separate nagent sub-conversation.
Optional <nagent-conversation> parameters: conversation-file loads a specific --conversation file; conversation-name loads a saved conversation like --load-conversation.

{file_edit_detail_block}
{install_context_block}{root_context_block}{knowledge_block}
{role_instructions}
</initial_context>"""


def create_initial_text(
    root: Path,
    process_path: Path,
    invocation: Invocation,
    conversation_name: str,
    parent_conversation: str | None = None,
    file_edit_path: Path | None = None,
    file_edit_id: str | None = None,
) -> str:
    initial_context = build_initial_context(
        root,
        process_path,
        invocation,
        conversation_name,
        parent_conversation,
        file_edit_path,
        file_edit_id,
    )

    return f"{initial_context}\n"


def refresh_initial_context(
    conversation_file: Path,
    root: Path,
    process_path: Path,
    invocation: Invocation,
    conversation_name: str,
    parent_conversation: str | None = None,
    file_edit_path: Path | None = None,
    file_edit_id: str | None = None,
    provider: str | None = None,
    model: str | None = None,
    config_path: Path | None = None,
) -> None:
    content = conversation_file.read_text(encoding="utf-8")
    previous_initial_context = extract_block(content, INITIAL_CONTEXT_BLOCK)
    updated_context = build_initial_context(
        root,
        process_path,
        invocation,
        conversation_name,
        parent_conversation,
        file_edit_path,
        file_edit_id,
        provider,
        model,
        config_path,
        previous_initial_context,
    )
    if previous_initial_context is not None:
        # Verbatim splice: replace_first_block has no escape semantics, so
        # backslash sequences in the rebuilt context survive untouched.
        content = replace_first_block(content, INITIAL_CONTEXT_BLOCK, updated_context)
    else:
        content = f"{updated_context}\n\n{content}"
    conversation_file.write_text(content, encoding="utf-8")


def ensure_initial_context(
    conversation_file: Path,
    root: Path,
    process_path: Path,
    invocation: Invocation,
    conversation_name: str,
    parent_conversation: str | None = None,
    file_edit_path: Path | None = None,
    file_edit_id: str | None = None,
) -> None:
    if not conversation_file.is_file():
        return
    content = conversation_file.read_text(encoding="utf-8")
    if find_block_span(content, INITIAL_CONTEXT_BLOCK) is not None:
        return
    block = build_initial_context(
        root,
        process_path,
        invocation,
        conversation_name,
        parent_conversation,
        file_edit_path,
        file_edit_id,
    )
    content = f"{block}\n\n{content}" if content.strip() else f"{block}\n"
    conversation_file.write_text(content, encoding="utf-8")


def default_conversation_name(pid: str) -> str:
    hostname = socket.gethostname()
    return f"latest-{hostname}-{pid}"


def parse_response(text: str) -> tuple[list[NagentTag] | None, str | None]:
    try:
        nodes = parse_tag_document(text)
    except TagParseError as exc:
        snippet = text[exc.offset : exc.offset + 80].replace("\n", "\\n")
        return None, f"Unexpected content at offset {exc.offset}: {exc.message} near {snippet!r}"

    if not nodes:
        return None, "Response contains no nagent tags."

    tags: list[NagentTag] = []
    for node in nodes:
        kind = TAG_KINDS.get(node.name)
        if kind is None:
            snippet = text[node.start : node.start + 80].replace("\n", "\\n")
            return None, f"Unexpected content at offset {node.start}: unsupported tag near {snippet!r}"

        if kind in ("response", "shell", "next"):
            if node.self_closing:
                return None, f"<{node.name}> requires a body, not a self-closing tag"
            if node.attrs:
                return None, f"<{node.name}> does not take attributes"
            tags.append(NagentTag(kind=kind, content=node.content))
        elif kind in ("read", "file_read", "file_patch"):
            attr = "index" if kind == "file_patch" else "path"
            if not node.self_closing:
                return None, f'<{node.name}> must be self-closing: <{node.name} {attr}="..." />'
            if set(node.attrs) != {attr}:
                return None, f'<{node.name}> requires exactly one {attr}="..." attribute'
            tags.append(NagentTag(kind=kind, content="", path=node.attrs[attr]))
        elif kind == "write":
            if node.self_closing:
                return None, "<nagent-write> requires file content between open and close tags"
            if set(node.attrs) != {"path"}:
                return None, '<nagent-write> requires exactly one path="..." attribute'
            tags.append(NagentTag(kind=kind, content=node.content, path=node.attrs["path"]))
        else:  # conversation
            if node.self_closing:
                return None, "<nagent-conversation> requires a prompt body"
            for attr_name in node.attrs:
                if attr_name not in ("conversation-file", "conversation-name"):
                    return None, f"Unsupported <nagent-conversation> attribute: {attr_name}"
            if "conversation-file" in node.attrs and "conversation-name" in node.attrs:
                return None, (
                    "<nagent-conversation> supports only one of conversation-file "
                    "or conversation-name"
                )
            tags.append(
                NagentTag(
                    kind=kind,
                    content=node.content,
                    conversation_file=node.attrs.get("conversation-file"),
                    conversation_name=node.attrs.get("conversation-name"),
                )
            )

    return tags, None



def clean_user_output(text: str) -> str:
    """Clean a <nagent-response> body before printing it to the user.

    The parser normally extracts the body of <nagent-response>, but LLM output
    can still occasionally contain an extra whole-response wrapper or a markdown
    code fence around the actual answer.  Strip only whole-output wrappers so
    inline examples and real code blocks remain intact.
    """

    cleaned = text.replace("\r\n", "\n").replace("\r", "\n").strip()

    changed = True
    while changed:
        changed = False

        fence_match = MARKDOWN_FENCE_PATTERN.match(cleaned)
        if fence_match:
            cleaned = fence_match.group(1).strip()
            changed = True
            continue

        for wrapper_name in USER_VISIBLE_WRAPPER_NAMES:
            unwrapped = unwrap_whole_element(cleaned, wrapper_name)
            if unwrapped is not None:
                cleaned = unwrapped.strip()
                changed = True
                break

    return cleaned


def append_to_conversation(conversation_file: Path, text: str) -> None:
    with conversation_file.open("a", encoding="utf-8") as handle:
        if conversation_file.stat().st_size > 0:
            handle.write("\n")
        handle.write(text)


def record_interrupt(conversation_file: Path) -> None:
    append_to_conversation(conversation_file, INTERRUPTED_MESSAGE)


def estimate_token_count(text: str) -> int:
    if not text:
        return 0
    return max(1, (len(text) + 3) // 4)


def coerce_token_count(value) -> int:
    try:
        return int(value or 0)
    except (TypeError, ValueError):
        return 0


def parse_llm_json_output(stdout: str) -> tuple[str, int, int] | None:
    try:
        payload = json.loads(stdout)
    except json.JSONDecodeError:
        return None
    response = payload.get("response")
    if not isinstance(response, str):
        return None
    return (
        response,
        coerce_token_count(payload.get("input_tokens")),
        coerce_token_count(payload.get("output_tokens")),
    )


def call_llm(
    conversation_file: Path,
    llm: LlmSettings,
    token_stats: TokenStats,
) -> tuple[str | None, str | None]:
    command = [
        str(NAGENT_LLM_TEXT),
        "--file",
        str(conversation_file),
        "--json",
        "--provider",
        llm.provider,
        "--model",
        llm.model,
    ]
    if llm.config_path is not None:
        command.extend(["--config", str(llm.config_path)])

    try:
        conversation_text = conversation_file.read_text(encoding="utf-8")
    except OSError:
        conversation_text = ""
    token_stats.conversation_input_tokens = estimate_token_count(conversation_text)

    try:
        with wait_spinner("Waiting for LLM"):
            result = subprocess.run(
                command,
                capture_output=True,
                text=True,
            )
    except Exception as exc:
        return None, str(exc)
    if result.returncode != 0:
        error = result.stderr.strip() or result.stdout.strip() or "nagent-llm-text failed"
        return None, error

    parsed = parse_llm_json_output(result.stdout)
    if parsed is None:
        llm_output = result.stdout
        input_tokens = token_stats.conversation_input_tokens
        output_tokens = estimate_token_count(llm_output)
    else:
        llm_output, input_tokens, output_tokens = parsed
        if input_tokens == 0:
            input_tokens = token_stats.conversation_input_tokens
        if output_tokens == 0:
            output_tokens = estimate_token_count(llm_output)

    token_stats.add_llm_turn(input_tokens, output_tokens)
    return llm_output, None


def execute_read(path: str) -> str:
    file_path = Path(path)
    if not file_path.is_file():
        return f'<nagent-read-result path="{path}" error="file not found" />'
    if file_path.stat().st_size > READ_SPLIT_THRESHOLD_BYTES:
        return (
            f'<nagent-read-result path="{path}" error="file too large; use '
            f'<nagent-file-read path=&quot;{path}&quot;/> instead" />'
        )
    try:
        content = file_path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as exc:
        return f'<nagent-read-result path="{path}" error="{exc}" />'
    return f'<nagent-read-result path="{path}">\n{content}\n</nagent-read-result>'


def execute_file_read(path: str, root: Path) -> str:
    file_path = Path(path)
    if not file_path.is_file():
        return f'<nagent-file-read-result path="{path}" error="file not found" />'

    size = file_path.stat().st_size
    if size <= READ_SPLIT_THRESHOLD_BYTES:
        try:
            content = file_path.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError) as exc:
            return f'<nagent-file-read-result path="{path}" error="{exc}" />'
        return (
            f'<nagent-file-read-result path="{path}" mode="inline" size_bytes="{size}">\n'
            f"{content}\n</nagent-file-read-result>"
        )

    output_dir = root / "splits" / f"{slugify(file_path.stem)}-{uuid.uuid4()}"
    command = [
        str(NAGENT_FILE_SPLIT),
        "--file",
        str(file_path),
        "--output",
        str(output_dir),
        "--json",
    ]
    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode != 0:
        error = result.stderr.strip() or result.stdout.strip() or "nagent-file-split failed"
        return f'<nagent-file-read-result path="{path}" error="{error}" />'

    try:
        payload = json.loads(result.stdout)
        segment_lines = "\n".join(
            f'- segment {segment["segment_index"]}: lines {segment["start_line_num"]}-'
            f'{segment["end_line_num"]} at {segment["path"]}'
            for segment in payload.get("segments", [])
        )
        index_path = payload["index_path"]
        segment_count = payload["segment_count"]
    except (json.JSONDecodeError, KeyError, TypeError) as exc:
        return (
            f'<nagent-file-read-result path="{path}" '
            f'error="invalid nagent-file-split output: {exc}" />'
        )
    return (
        f'<nagent-file-read-result path="{path}" mode="split" size_bytes="{size}" '
        f'index_path="{index_path}" segment_count="{segment_count}">\n'
        f"File exceeded {READ_SPLIT_THRESHOLD_BYTES} bytes and was split.\n"
        f"index_path: {index_path}\n"
        f"segments:\n{segment_lines}\n"
        f"Edit segment files, then merge with: <nagent-file-patch index=\"{index_path}\"/>\n"
        f"</nagent-file-read-result>"
    )


def execute_file_patch(index: str) -> str:
    index_path = Path(index).expanduser()
    try:
        result = apply_segment_patches(index_path)
    except (FileNotFoundError, ValueError) as exc:
        return f'<nagent-file-patch-result index="{index}" status="error">{exc}</nagent-file-patch-result>'

    changed = "true" if result.changed else "false"
    patch_path = str(result.patch_path.resolve()) if result.patch_path else ""
    return (
        f'<nagent-file-patch-result index="{index}" status="ok" changed="{changed}" '
        f'source_path="{result.source_path}" patch_path="{patch_path}" />'
    )


def tmp_roots() -> list[Path]:
    candidates = [Path("/tmp"), Path("/var/tmp")]
    tmpdir = os.environ.get("TMPDIR")
    if tmpdir:
        candidates.insert(0, Path(tmpdir))

    roots: list[Path] = []
    seen: set[str] = set()
    for candidate in candidates:
        try:
            resolved = candidate.expanduser().resolve()
        except OSError:
            continue
        key = str(resolved)
        if key not in seen:
            seen.add(key)
            roots.append(resolved)
    return roots


def is_tmp_path(path: Path) -> bool:
    try:
        resolved = path.resolve()
    except OSError:
        return False
    for root in tmp_roots():
        if resolved == root or root in resolved.parents:
            return True
    return False


def validate_write_path(
    path: str,
    file_edit_path: Path | None,
    root: Path | None = None,
    file_edit_id: str | None = None,
) -> str | None:
    file_path = Path(path)
    if file_edit_path is not None:
        try:
            resolved = file_path.expanduser().resolve()
        except OSError as exc:
            return f"write not allowed: {exc}"
        try:
            if same_file(resolved, file_edit_path):
                return None
        except OSError:
            pass
        if file_edit_id is not None:
            try:
                if file_id_for_path(resolved) == file_edit_id:
                    return None
            except OSError:
                pass
        if root is not None and is_split_segment_for_source(
            resolved, file_edit_path, root, file_edit_id
        ):
            return None
        return (
            f"write not allowed: only {file_edit_path} or its split segments "
            "may be edited in this session"
        )
    try:
        if is_tmp_path(file_path.expanduser()):
            return None
    except OSError:
        pass
    return "write not allowed: use nagent-file-edit to edit files outside temp directories"


def execute_write(
    path: str,
    content: str,
    file_edit_path: Path | None = None,
    root: Path | None = None,
    file_edit_id: str | None = None,
) -> str:
    error = validate_write_path(path, file_edit_path, root, file_edit_id)
    if error is not None:
        return f'<nagent-write-result path="{path}" status="error">{error}</nagent-write-result>'

    # Validation resolves "~"; write to the same expanded path, not a literal "~" directory.
    file_path = Path(path).expanduser()
    try:
        file_path.parent.mkdir(parents=True, exist_ok=True)
        file_path.write_text(content, encoding="utf-8")
        return f'<nagent-write-result path="{path}" status="ok" />'
    except OSError as exc:
        return f'<nagent-write-result path="{path}" status="error">{exc}</nagent-write-result>'


def execute_shell(commands: str, token_stats: TokenStats | None = None) -> str:
    with wait_spinner("Running command"):
        result = subprocess.run(
            commands,
            shell=True,
            capture_output=True,
            text=True,
        )
    stdout = result.stdout.rstrip("\n")
    stderr = result.stderr.rstrip("\n")
    parts = [
        "<nagent-shell-result>",
        f"exit_code: {result.returncode}",
    ]
    if stdout:
        parts.extend(["stdout:", stdout])
    if stderr:
        parts.extend(["stderr:", stderr])
    parts.append("</nagent-shell-result>")
    return "\n".join(parts)


def execute_agent(
    prompt: str,
    root: Path,
    llm: LlmSettings,
    nagent_path: Path,
    parent_conversation: str,
    pid: str,
    token_stats: TokenStats | None = None,
    conversation_file: str | None = None,
    conversation_name: str | None = None,
) -> str:
    child_conversation_name = conversation_file or f"{uuid.uuid4()}-{pid}"
    if conversation_name is not None:
        source = resolve_saved_conversation_reference(root, pid, conversation_name)
        try:
            load_conversation(resolve_conversation(root, child_conversation_name), source)
        except FileNotFoundError as exc:
            return (
                f'<nagent-conversation-result conversation="{child_conversation_name}" '
                'tokens_in="0" tokens_out="0">\n'
                "exit_code: 1\n"
                "stderr:\n"
                f"Error: {exc}\n"
                "</nagent-conversation-result>"
            )
    command = [
        str(nagent_path),
        "--root",
        str(root),
        "--conversation",
        child_conversation_name,
        "--provider",
        llm.provider,
        "--model",
        llm.model,
    ]
    if llm.config_path is not None:
        command.extend(["--config", str(llm.config_path)])
    command.append("--json")
    command.extend(
        [
            "--invocation",
            "delegated",
            "--parent-conversation",
            parent_conversation,
            "--pid",
            pid,
            prompt,
        ]
    )

    with wait_spinner("Sub-conversation working"):
        result = subprocess.run(
            command,
            capture_output=True,
            text=True,
        )
    output = result.stdout.rstrip("\n")
    child_input_tokens = 0
    child_output_tokens = 0
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError:
        payload = None
    if isinstance(payload, dict):
        responses = payload.get("responses")
        if isinstance(responses, list):
            output = "\n".join(str(response) for response in responses)
        child_input_tokens = coerce_token_count(
            payload.get("recursive_input_tokens") or payload.get("tokens_in")
        )
        child_output_tokens = coerce_token_count(
            payload.get("recursive_output_tokens") or payload.get("tokens_out")
        )
        if token_stats is not None:
            token_stats.add_recursive(child_input_tokens, child_output_tokens)
    stderr = result.stderr.rstrip("\n")
    parts = [
        (
            f'<nagent-conversation-result conversation="{child_conversation_name}" '
            f'tokens_in="{child_input_tokens}" tokens_out="{child_output_tokens}">'
        ),
        f"exit_code: {result.returncode}",
    ]
    if output:
        parts.extend(["output:", output])
    if stderr:
        parts.extend(["stderr:", stderr])
    parts.append("</nagent-conversation-result>")
    return "\n".join(parts)


def process_tags(
    tags: list[NagentTag],
    conversation_file: Path,
    root: Path,
    llm: LlmSettings,
    nagent_path: Path,
    pid: str,
    token_stats: TokenStats,
    file_edit_path: Path | None = None,
    file_edit_id: str | None = None,
) -> tuple[list[str], list[str], bool]:
    responses: list[str] = []
    next_prompts: list[str] = []
    should_continue = False

    for tag in tags:
        if tag.kind == "response":
            responses.append(tag.content)
        elif tag.kind == "read":
            append_to_conversation(conversation_file, execute_read(tag.path or ""))
            should_continue = True
        elif tag.kind == "file_read":
            append_to_conversation(conversation_file, execute_file_read(tag.path or "", root))
            should_continue = True
        elif tag.kind == "file_patch":
            append_to_conversation(conversation_file, execute_file_patch(tag.path or ""))
            should_continue = True
        elif tag.kind == "write":
            append_to_conversation(
                conversation_file,
                execute_write(tag.path or "", tag.content, file_edit_path, root, file_edit_id),
            )
            should_continue = True
        elif tag.kind == "shell":
            append_to_conversation(conversation_file, execute_shell(tag.content, token_stats))
            should_continue = True
        elif tag.kind == "conversation":
            append_to_conversation(
                conversation_file,
                execute_agent(
                    tag.content,
                    root,
                    llm,
                    nagent_path,
                    conversation_file.name,
                    pid,
                    token_stats,
                    conversation_file=tag.conversation_file,
                    conversation_name=tag.conversation_name,
                ),
            )
            should_continue = True
        elif tag.kind == "next":
            next_prompts.append(tag.content)

    return responses, next_prompts, should_continue


def run_agent_loop(
    conversation_file: Path,
    root: Path,
    llm: LlmSettings,
    initial_prompt: str | None,
    pid: str,
    file_edit_path: Path | None = None,
    file_edit_id: str | None = None,
    *,
    json_mode: bool = False,
    token_stats: TokenStats | None = None,
    initial_read_paths: list[str] | None = None,
) -> tuple[int, list[str]]:
    nagent_path = Path(__file__).resolve()
    user_responses: list[str] = []
    token_stats = token_stats or TokenStats()

    for read_path in initial_read_paths or []:
        append_to_conversation(conversation_file, execute_read(read_path))

    if initial_prompt is not None:
        append_to_conversation(conversation_file, f"<user-prompt>\n{initial_prompt}\n</user-prompt>")

    while True:
        llm_output, error = None, None
        for attempt in range(MAX_FORMAT_RETRIES):
            llm_output, error = call_llm(conversation_file, llm, token_stats)
            if error is not None:
                append_to_conversation(
                    conversation_file,
                    f"<system>LLM provider error on attempt {attempt + 1} of "
                    f"{MAX_FORMAT_RETRIES}: {error}</system>",
                )
                continue

            tags, parse_error = parse_response(llm_output)
            if tags is not None:
                break

            append_to_conversation(
                conversation_file,
                f"<agent-response>\n{llm_output}\n</agent-response>\n"
                f"<system>Invalid nagent response format: {parse_error}. "
                f"Respond only with valid nagent tags.</system>",
            )
        else:
            if error is not None:
                message = (
                    f"Error: LLM provider failed after {MAX_FORMAT_RETRIES} attempts; "
                    "nagent cannot continue."
                )
            else:
                message = (
                    f"Error: nagent response remained invalid after {MAX_FORMAT_RETRIES} attempts."
                )
            user_responses.append(message)
            if not json_mode:
                print(message)
            return 1, user_responses

        append_to_conversation(conversation_file, f"<agent-response>\n{llm_output}\n</agent-response>")

        responses, next_prompts, should_continue = process_tags(
            tags,
            conversation_file,
            root,
            llm,
            nagent_path,
            pid,
            token_stats,
            file_edit_path,
            file_edit_id,
        )

        for response in responses:
            cleaned = clean_user_output(response)
            user_responses.append(cleaned)
            if not json_mode:
                print(cleaned)

        if next_prompts:
            for prompt in next_prompts:
                append_to_conversation(conversation_file, f"<nagent-next-input>\n{prompt}\n</nagent-next-input>")
            continue

        if should_continue:
            continue

        return 0, user_responses


def conversations_dir(root: Path) -> Path:
    return root / "conversations"


def saved_conversations_index_path(root: Path, pid: str) -> Path:
    return conversations_dir(root) / f"index-saved-conversations-{pid}.json"


def resolve_conversation(root: Path, conversation_name: str) -> Path:
    return conversations_dir(root) / conversation_name


def resolve_conversation_reference(root: Path, name: str) -> Path:
    reference = Path(name).expanduser()
    if reference.is_absolute() or reference.parent != Path("."):
        return reference
    return resolve_conversation(root, name)


def resolve_saved_conversation_reference(root: Path, pid: str, name: str) -> Path:
    payload = load_saved_conversations_index(root, pid)
    for entry in payload["conversations"]:
        if entry.get("name") != name:
            continue
        path_text = entry.get("path")
        if isinstance(path_text, str) and path_text:
            return Path(path_text).expanduser()
    return resolve_conversation_reference(root, name)


def migrate_legacy_conversation(root: Path, conversation_name: str, conversation_file: Path) -> Path | None:
    legacy_file = root / conversation_name
    if legacy_file == conversation_file or not legacy_file.is_file() or conversation_file.exists():
        return None

    conversation_file.parent.mkdir(parents=True, exist_ok=True)
    legacy_file.rename(conversation_file)
    return conversation_file


def archive_conversation(conversation_file: Path) -> Path | None:
    if not conversation_file.is_file():
        return None
    archive_path = conversation_file.with_name(f"{conversation_file.name}-{uuid.uuid4()}")
    conversation_file.rename(archive_path)
    return archive_path


def save_conversation(conversation_file: Path, target: Path) -> Path:
    if not conversation_file.is_file():
        raise FileNotFoundError(f"conversation not found: {conversation_file}")
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(conversation_file, target)
    return target


def summarize_saved_conversation(
    conversation_file: Path,
    provider: str | None,
    model: str | None,
    config_path: Path | None,
) -> str:
    command = [
        str(NAGENT_FILE_SUMMARIZE),
        "--file",
        str(conversation_file),
        "--max-word-count",
        str(SAVED_CONVERSATION_SUMMARY_WORD_COUNT),
        "--json",
    ]
    if provider:
        command.extend(["--provider", provider])
    if model:
        command.extend(["--model", model])
    if config_path is not None:
        command.extend(["--config", str(config_path.expanduser())])

    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode != 0:
        error = result.stderr.strip() or result.stdout.strip() or "nagent-file-summarize failed"
        raise RuntimeError(error)
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"invalid nagent-file-summarize JSON output: {exc}") from exc
    summary = payload.get("summary")
    if not isinstance(summary, str):
        raise RuntimeError("nagent-file-summarize output did not include a summary")
    return summary.strip()


def load_saved_conversations_index(root: Path, pid: str) -> dict:
    index_path = saved_conversations_index_path(root, pid)
    payload: dict = {
        "pid": pid,
        "index_path": str(index_path.resolve()),
        "conversations": [],
    }
    if not index_path.is_file():
        return payload
    try:
        loaded = json.loads(index_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return payload
    if not isinstance(loaded, dict):
        return payload
    conversations = loaded.get("conversations", [])
    if not isinstance(conversations, list):
        conversations = []
    payload["conversations"] = [
        entry for entry in conversations
        if isinstance(entry, dict)
    ]
    return payload


def update_saved_conversations_index(
    root: Path,
    pid: str,
    name: str,
    saved_path: Path,
    summary: str,
) -> Path:
    index_path = saved_conversations_index_path(root, pid)
    payload = load_saved_conversations_index(root, pid)
    saved_path_text = str(saved_path.resolve())
    entry = {
        "name": name,
        "path": saved_path_text,
        "summary": summary,
    }
    conversations = [
        existing for existing in payload["conversations"]
        if existing.get("path") != saved_path_text and existing.get("name") != name
    ]
    conversations.append(entry)
    payload["pid"] = pid
    payload["index_path"] = str(index_path.resolve())
    payload["conversations"] = conversations
    index_path.parent.mkdir(parents=True, exist_ok=True)
    index_path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return index_path


def load_conversation(conversation_file: Path, source: Path) -> Path | None:
    if not source.is_file():
        raise FileNotFoundError(f"conversation not found: {source}")
    source_is_current = False
    try:
        source_is_current = source.resolve() == conversation_file.resolve()
    except OSError:
        source_is_current = source == conversation_file
    archived = archive_conversation(conversation_file)
    copy_source = archived if source_is_current and archived is not None else source
    conversation_file.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(copy_source, conversation_file)
    return archived


def clear_conversation(
    conversation_file: Path,
    root: Path,
    process_path: Path,
    invocation: Invocation,
    conversation_name: str,
    parent_conversation: str | None = None,
    file_edit_path: Path | None = None,
    file_edit_id: str | None = None,
) -> Path | None:
    archived = archive_conversation(conversation_file)
    conversation_file.parent.mkdir(parents=True, exist_ok=True)
    conversation_file.write_text(
        create_initial_text(
            root,
            process_path,
            invocation,
            conversation_name,
            parent_conversation,
            file_edit_path,
            file_edit_id,
        ),
        encoding="utf-8",
    )
    return archived


def print_conversation_status(
    conversation_file: Path,
    provider: str,
    model: str,
    root: Path,
    *,
    json_mode: bool = False,
) -> None:
    size = conversation_file.stat().st_size if conversation_file.is_file() else 0
    knowledge_counts = knowledge_item_counts(root)
    knowledge_total = sum(knowledge_counts.values())
    root_size = root_size_bytes(root)
    if json_mode:
        emit_json(
            {
                "conversation_path": str(conversation_file.resolve()),
                "size": size,
                "provider": provider,
                "model": model,
                "root_size_bytes": root_size,
                "knowledge_items": knowledge_counts,
            }
        )
        return
    print(f"conversation:{conversation_file} size:{size}")
    print(f"provider:{provider} model:{model}")
    print(f"knowledge_items:{knowledge_total} root_size_bytes:{root_size}")


def print_save_conversation_result(
    conversation_file: Path,
    saved_path: Path,
    *,
    summary: str | None = None,
    index_path: Path | None = None,
    json_mode: bool = False,
) -> None:
    if json_mode:
        payload = {
            "conversation_path": str(conversation_file.resolve()),
            "saved_path": str(saved_path.resolve()),
        }
        if summary is not None:
            payload["summary"] = summary
        if index_path is not None:
            payload["index_path"] = str(index_path.resolve())
        emit_json(payload)
        return
    print(f"saved:{saved_path}")
    if index_path is not None:
        print(f"saved_conversations_index:{index_path}")
    print(f"conversation:{conversation_file}")


def print_load_conversation_result(
    conversation_file: Path,
    source_path: Path,
    archived_path: Path | None,
    *,
    json_mode: bool = False,
) -> None:
    if json_mode:
        payload = {
            "conversation_path": str(conversation_file.resolve()),
            "loaded_path": str(source_path.resolve()),
        }
        if archived_path is not None:
            payload["archived_path"] = str(archived_path.resolve())
        emit_json(payload)
        return
    if archived_path is not None:
        print(f"archived:{archived_path}")
    print(f"loaded:{source_path}")
    print(f"conversation:{conversation_file}")


def summarize_conversation(
    conversation_file: Path,
    provider: str | None,
    model: str | None,
    config_path: Path | None,
    *,
    json_mode: bool = False,
    print_status: bool = False,
) -> int:
    if not conversation_file.is_file():
        print(f"Error: conversation not found: {conversation_file}", file=sys.stderr)
        return 1

    try:
        resolved_provider, resolved_model = resolve_settings(provider, model, config_path)
    except ValueError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1
    require_credentials(resolved_provider)

    try:
        conversation_text = conversation_file.read_text(encoding="utf-8")
    except OSError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1

    token_stats = TokenStats(conversation_input_tokens=estimate_token_count(conversation_text))
    summary_prompt = (
        "Summarize the following nagent conversation for future context. "
        "Focus on the user's goals, decisions made, implementation changes, "
        "commands or tests run, unresolved issues, and any important file paths. "
        "Do not summarize nagent as a tool; summarize only this conversation.\n\n"
        "<conversation>\n"
        f"{conversation_text}\n"
        "</conversation>\n"
    )

    with tempfile.NamedTemporaryFile("w", encoding="utf-8", suffix=".txt", delete=False) as handle:
        prompt_path = Path(handle.name)
        handle.write(summary_prompt)

    command = [
        str(NAGENT_LLM_TEXT),
        "--file",
        str(prompt_path),
        "--json",
        "--provider",
        resolved_provider,
        "--model",
        resolved_model,
    ]
    if config_path is not None:
        command.extend(["--config", str(config_path.expanduser())])

    try:
        with wait_spinner("Summarizing conversation"):
            result = subprocess.run(command, capture_output=True, text=True)
    finally:
        try:
            prompt_path.unlink()
        except OSError:
            pass

    if result.returncode != 0:
        error = result.stderr.strip() or result.stdout.strip() or "nagent-llm-text failed"
        print(f"Error: {error}", file=sys.stderr)
        return result.returncode

    parsed = parse_llm_json_output(result.stdout)
    if parsed is None:
        summary = result.stdout
        input_tokens = estimate_token_count(summary_prompt)
        output_tokens = estimate_token_count(summary)
    else:
        summary, input_tokens, output_tokens = parsed
        if input_tokens == 0:
            input_tokens = estimate_token_count(summary_prompt)
        if output_tokens == 0:
            output_tokens = estimate_token_count(summary)

    token_stats.turn_count += 1
    token_stats.recursive_input_tokens += input_tokens
    token_stats.recursive_output_tokens += output_tokens

    if json_mode:
        payload = {
            "conversation_path": str(conversation_file.resolve()),
            "summary": summary,
            **token_stats.as_dict(),
        }
        payload["tokens_in"] = token_stats.recursive_input_tokens
        payload["tokens_out"] = token_stats.recursive_output_tokens
        emit_json(payload)
    else:
        print(summary)
        if print_status:
            print(token_stats.status_line())
    return 0


def edit_conversation(
    conversation_file: Path,
    root: Path,
    process_path: Path,
    invocation: Invocation,
    conversation_name: str,
    pid: str,
    parent_conversation: str | None,
    prompt: str,
    provider: str | None,
    model: str | None,
    config_path: Path | None,
    file_edit_path: Path | None = None,
    file_edit_id: str | None = None,
    *,
    json_mode: bool = False,
    spinner_message: str = "Editing conversation",
) -> int:
    archived = clear_conversation(
        conversation_file,
        root,
        process_path,
        invocation,
        conversation_name,
        parent_conversation,
        file_edit_path,
        file_edit_id,
    )
    if archived is None:
        print(f"Error: conversation not found: {conversation_file}", file=sys.stderr)
        return 1

    archived_content = archived.read_text(encoding="utf-8")
    preserved_context = extract_block(archived_content, INITIAL_CONTEXT_BLOCK)
    if preserved_context is not None:
        stripped = remove_first_block(archived_content, INITIAL_CONTEXT_BLOCK).lstrip("\n")
        archived.write_text(stripped, encoding="utf-8")

    command = [
        str(process_path),
        "--file-edit",
        str(archived),
        "--root",
        str(root),
        "--pid",
        pid,
        "--clear",
    ]
    if provider:
        command.extend(["--provider", provider])
    if model:
        command.extend(["--model", model])
    if config_path is not None:
        command.extend(["--config", str(config_path.expanduser())])
    # Always ask the child for JSON: its token accounting is data this
    # invocation must roll up, in either output mode.
    command.append("--json")
    command.append(prompt)

    with wait_spinner(spinner_message):
        result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode != 0:
        if result.stdout:
            print(result.stdout, end="")
        if result.stderr:
            print(result.stderr, end="", file=sys.stderr)
        return result.returncode

    token_stats = TokenStats()
    try:
        child_payload = json.loads(result.stdout)
    except json.JSONDecodeError:
        child_payload = None
    if isinstance(child_payload, dict):
        token_stats.turn_count = coerce_token_count(child_payload.get("turn_count"))
        token_stats.conversation_input_tokens = coerce_token_count(
            child_payload.get("conversation_input_tokens")
        )
        token_stats.recursive_input_tokens = coerce_token_count(
            child_payload.get("recursive_input_tokens") or child_payload.get("tokens_in")
        )
        token_stats.recursive_output_tokens = coerce_token_count(
            child_payload.get("recursive_output_tokens") or child_payload.get("tokens_out")
        )

    edited_body = archived.read_text(encoding="utf-8").lstrip("\n")
    if preserved_context is not None:
        archived.write_text(f"{preserved_context}\n\n{edited_body}", encoding="utf-8")

    loaded_archive = load_conversation(conversation_file, archived)
    ensure_initial_context(
        conversation_file,
        root,
        process_path,
        invocation,
        conversation_name,
        parent_conversation,
        file_edit_path,
        file_edit_id,
    )
    if json_mode:
        payload = {
            "conversation_path": str(conversation_file.resolve()),
            "edited_path": str(archived.resolve()),
            **token_stats.as_dict(),
        }
        payload["tokens_in"] = token_stats.recursive_input_tokens
        payload["tokens_out"] = token_stats.recursive_output_tokens
        if loaded_archive is not None:
            payload["archived_path"] = str(loaded_archive.resolve())
        emit_json(payload)
    else:
        print(f"edited:{archived}")
        print(f"conversation:{conversation_file}")
        print(token_stats.status_line())
    return 0


def compact_prompt_path(root: Path) -> Path:
    # The compaction prompt is user-editable data. A copy under the nagent
    # root wins over the repo copy shipped next to the executable, and the
    # repo copy keeps --compact working from a plain checkout.
    user_prompt = root / "prompts" / "compact-conversation.md"
    if user_prompt.is_file():
        return user_prompt
    return COMPACT_PROMPT_PATH


def compact_conversation(
    conversation_file: Path,
    root: Path,
    process_path: Path,
    invocation: Invocation,
    conversation_name: str,
    pid: str,
    parent_conversation: str | None,
    provider: str | None,
    model: str | None,
    config_path: Path | None,
    file_edit_path: Path | None = None,
    file_edit_id: str | None = None,
    *,
    json_mode: bool = False,
) -> int:
    try:
        compact_guidance = compact_prompt_path(root).read_text(encoding="utf-8").strip()
    except OSError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1

    prompt = (
        f"{compact_guidance}\n\n"
        "Compact this conversation now, following the guidance above. "
        "Rewrite it in place so it is substantially smaller while preserving "
        "future capability."
    )
    return edit_conversation(
        conversation_file,
        root,
        process_path,
        invocation,
        conversation_name,
        pid,
        parent_conversation,
        prompt,
        provider,
        model,
        config_path,
        file_edit_path,
        file_edit_id,
        json_mode=json_mode,
        spinner_message="Compacting conversation",
    )


def print_file_edits(root: Path, pid: str, *, json_mode: bool = False) -> None:
    payload = list_file_edits(root, pid)
    if json_mode:
        emit_json(payload)
        return
    print(f"file_index:{payload['file_index_path']}")
    for entry in payload["files"]:
        print(f"{entry['file_id']}\t{entry.get('path', '')}\t{entry.get('conversation', '')}")


def print_saved_conversations(root: Path, pid: str, *, json_mode: bool = False) -> None:
    payload = load_saved_conversations_index(root, pid)
    if json_mode:
        emit_json(payload)
        return
    print(f"saved_conversations_index:{payload['index_path']}")
    for entry in payload["conversations"]:
        print(f"{entry.get('name', '')}\t{entry.get('path', '')}\t{entry.get('summary', '')}")


def resolve_initial_prompt(prompt_arg: str | list[str] | None) -> str | None:
    if isinstance(prompt_arg, list):
        prompt_parts = prompt_arg
    elif prompt_arg is None:
        prompt_parts = []
    else:
        prompt_parts = [prompt_arg]

    if prompt_parts and prompt_parts[-1] == "-":
        stdin_prompt = sys.stdin.read()
        leading_prompt = " ".join(prompt_parts[:-1])
        if leading_prompt and stdin_prompt:
            return f"{leading_prompt}\n{stdin_prompt}"
        return leading_prompt or stdin_prompt or None

    if prompt_parts:
        return " ".join(prompt_parts)

    if sys.stdin.isatty():
        return None
    try:
        readable, _, _ = select.select([sys.stdin], [], [], 0)
    except (OSError, ValueError):
        readable = [sys.stdin]
    if not readable:
        return None
    prompt = sys.stdin.read()
    return prompt if prompt else None


def main() -> int:
    exit_on_description(NAGENT_DESCRIPTION)

    parser = argparse.ArgumentParser(description="Run the nagent conversation loop.")
    parser.add_argument(
        "--root",
        default="~/.nagent",
        help="Root directory for config and conversations (default: ~/.nagent).",
    )
    parser.add_argument(
        "--conversation",
        help='Conversation name (default: latest-{hostname}-{pid}).',
    )
    parser.add_argument(
        "--model",
        help="Model passed to nagent-llm-text (default: from config or provider default).",
    )
    parser.add_argument(
        "--provider",
        choices=PROVIDERS,
        help="LLM provider (default: from ~/.nagent/config.json or openai).",
    )
    parser.add_argument(
        "--config",
        type=Path,
        help="Path to nagent config JSON (default: ~/.nagent/config.json).",
    )
    parser.add_argument(
        "--invocation",
        choices=["user", "delegated"],
        default="user",
        help='Whether this instance was started by a human (user) or a parent nagent (delegated).',
    )
    parser.add_argument(
        "--parent-conversation",
        help="Parent conversation name when --invocation=delegated.",
    )
    parser.add_argument(
        "--pid",
        help=(
            "Shell process ID shared across sub-conversations "
            "(default: STY-WINDOW, BASHPID, or parent shell pid)."
        ),
    )
    parser.add_argument(
        "--status",
        action="store_true",
        help="Print the conversation path and file size, then exit.",
    )
    parser.add_argument(
        "--list-models",
        action="store_true",
        help="List models available for the configured provider, then exit.",
    )
    parser.add_argument(
        "--list-file-edits",
        action="store_true",
        help="List per-file edit conversations for the current shell pid, then exit.",
    )
    parser.add_argument(
        "--list-conversations",
        action="store_true",
        help="List saved conversations for the current shell pid, then exit.",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Print structured JSON output instead of plain text.",
    )
    parser.add_argument(
        "--clear",
        action="store_true",
        help="Archive the current conversation file and start a fresh one at the same path.",
    )
    parser.add_argument(
        "--save-conversation",
        metavar="NAME",
        help="Copy the current conversation to NAME without changing the loaded conversation.",
    )
    parser.add_argument(
        "--load-conversation",
        metavar="NAME",
        help="Archive the current conversation, then copy NAME into the current conversation path.",
    )
    parser.add_argument(
        "--branch-conversation",
        metavar="CONVERSATION_NAME",
        help=(
            "Archive the current conversation, then copy CONVERSATION_NAME from "
            "the conversations directory into the current conversation path."
        ),
    )
    parser.add_argument(
        "--summarize",
        action="store_true",
        help="Print an LLM-generated summary of the loaded conversation, then exit.",
    )
    parser.add_argument(
        "--edit-conversation",
        action="store_true",
        help=(
            "Archive the current conversation, edit that backup using the prompt, "
            "then load the edited backup."
        ),
    )
    parser.add_argument(
        "--compact",
        action="store_true",
        help=(
            "Archive the current conversation, rewrite that backup into a compacted "
            "form using the compaction guidance, then load the compacted backup."
        ),
    )
    parser.add_argument(
        "--read",
        action="append",
        default=[],
        metavar="PATH",
        help=(
            "Copy a text file into the current conversation before the prompt. "
            "May be repeated."
        ),
    )
    parser.add_argument(
        "--file-edit",
        type=Path,
        metavar="PATH",
        help="Edit a specific file using its per-file conversation (see nagent-file-edit).",
    )
    parser.add_argument(
        "prompt",
        nargs="*",
        help="Prompt text. Use trailing '-' to read stdin until EOF.",
    )
    args = parser.parse_args()

    root = Path(args.root).expanduser()
    user_direct_mode = args.invocation == "user" and args.pid is None
    pid = args.pid or default_pid()
    file_edit_path: Path | None = None
    file_edit_id: str | None = None

    if args.file_edit is not None:
        try:
            conversation_name, file_edit_path, file_edit_id = resolve_file_edit_conversation(
                root, pid, args.file_edit
            )
        except FileNotFoundError as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1
    else:
        conversation_name = args.conversation or default_conversation_name(pid)
    conversation_file = resolve_conversation(root, conversation_name)
    migrate_legacy_conversation(root, conversation_name, conversation_file)

    set_spinner_enabled(
        args.invocation == "user"
        and sys.stderr.isatty()
        and not os.environ.get("NAGENT_NO_SPINNER")
    )

    if args.status:
        try:
            provider, model = resolve_settings(args.provider, args.model, args.config)
        except ValueError as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1
        print_conversation_status(conversation_file, provider, model, root, json_mode=args.json)
        return 0

    if args.list_file_edits:
        print_file_edits(root, pid, json_mode=args.json)
        return 0

    if args.list_conversations:
        print_saved_conversations(root, pid, json_mode=args.json)
        return 0

    if args.list_models:
        try:
            provider = resolve_provider(args.provider, args.config)
        except ValueError as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1
        require_credentials(provider)
        try:
            models = list(list_models(provider))
        except Exception as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1
        if args.json:
            emit_json({"provider": provider, "models": models})
        else:
            for model_name in models:
                print(model_name)
        return 0

    if args.summarize:
        return summarize_conversation(
            conversation_file,
            args.provider,
            args.model,
            args.config,
            json_mode=args.json,
            print_status=user_direct_mode,
        )

    initial_prompt = resolve_initial_prompt(args.prompt)

    process_path = Path(__file__).resolve()

    if args.edit_conversation:
        if initial_prompt is None:
            parser.error("prompt is required with --edit-conversation")
        return edit_conversation(
            conversation_file,
            root,
            process_path,
            args.invocation,
            conversation_name,
            pid,
            args.parent_conversation,
            initial_prompt,
            args.provider,
            args.model,
            args.config,
            file_edit_path,
            file_edit_id,
            json_mode=args.json,
        )

    if args.compact:
        return compact_conversation(
            conversation_file,
            root,
            process_path,
            args.invocation,
            conversation_name,
            pid,
            args.parent_conversation,
            args.provider,
            args.model,
            args.config,
            file_edit_path,
            file_edit_id,
            json_mode=args.json,
        )

    cleared = False
    if args.clear:
        archived = clear_conversation(
            conversation_file,
            root,
            process_path,
            args.invocation,
            conversation_name,
            args.parent_conversation,
            file_edit_path,
            file_edit_id,
        )
        if archived is not None:
            if args.json:
                emit_json(
                    {
                        "archived_path": str(archived.resolve()),
                        "conversation_path": str(conversation_file.resolve()),
                    }
                )
            else:
                print(f"archived:{archived}")
                print(f"conversation:{conversation_file}")
        elif args.json:
            emit_json({"conversation_path": str(conversation_file.resolve())})
        else:
            print(f"conversation:{conversation_file}")
        cleared = True
        if (
            initial_prompt is None
            and not args.read
            and args.load_conversation is None
            and args.branch_conversation is None
            and args.save_conversation is None
        ):
            return 0

    if args.branch_conversation is not None:
        source = resolve_conversation(root, args.branch_conversation)
        try:
            archived = load_conversation(conversation_file, source)
        except FileNotFoundError as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1
        ensure_initial_context(
            conversation_file,
            root,
            process_path,
            args.invocation,
            conversation_name,
            args.parent_conversation,
            file_edit_path,
            file_edit_id,
        )
        print_load_conversation_result(conversation_file, source, archived, json_mode=args.json)

    if args.load_conversation is not None:
        source = resolve_conversation_reference(root, args.load_conversation)
        try:
            archived = load_conversation(conversation_file, source)
        except FileNotFoundError as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1
        ensure_initial_context(
            conversation_file,
            root,
            process_path,
            args.invocation,
            conversation_name,
            args.parent_conversation,
            file_edit_path,
            file_edit_id,
        )
        print_load_conversation_result(conversation_file, source, archived, json_mode=args.json)

    if args.save_conversation is not None:
        target = resolve_conversation_reference(root, args.save_conversation)
        try:
            saved = save_conversation(conversation_file, target)
        except FileNotFoundError as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1
        # Saving is a file copy; the summary is best-effort metadata. A
        # provider or credential failure must not leave the saved copy
        # missing from the index.
        try:
            summary = summarize_saved_conversation(saved, args.provider, args.model, args.config)
        except RuntimeError as exc:
            error_line = str(exc).strip().splitlines()[0] if str(exc).strip() else "unknown error"
            summary = f"(summary unavailable: {error_line})"
            print(f"Warning: conversation summary unavailable: {error_line}", file=sys.stderr)
        index_path = update_saved_conversations_index(
            root,
            pid,
            args.save_conversation,
            saved,
            summary,
        )
        print_save_conversation_result(
            conversation_file,
            saved,
            summary=summary,
            index_path=index_path,
            json_mode=args.json,
        )

    if (
        initial_prompt is None
        and not args.read
        and (
            args.branch_conversation is not None
            or args.load_conversation is not None
            or args.save_conversation is not None
        )
    ):
        return 0

    if initial_prompt is None and not args.read:
        parser.error(
            "prompt is required unless --status, --list-models, --list-file-edits, "
            "--list-conversations, --clear, --save-conversation, --load-conversation, "
            "--branch-conversation, --summarize, --read, or stdin prompt text is given"
        )

    try:
        provider, model = resolve_settings(args.provider, args.model, args.config)
    except ValueError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1
    require_credentials(provider)
    llm = LlmSettings(provider=provider, model=model, config_path=args.config)

    conversation_file.parent.mkdir(parents=True, exist_ok=True)

    if not cleared and not conversation_file.exists():
        # Fresh conversation: build the full context exactly once. Provider and
        # model are resolved at this point, so the file-edit history block is
        # included; refreshing again would re-run tool discovery and git probes
        # for nothing. Every delegated sub-conversation takes this path.
        conversation_file.write_text(
            build_initial_context(
                root,
                process_path,
                args.invocation,
                conversation_name,
                args.parent_conversation,
                file_edit_path,
                file_edit_id,
                provider,
                model,
                args.config,
            )
            + "\n",
            encoding="utf-8",
        )
    else:
        refresh_initial_context(
            conversation_file,
            root,
            process_path,
            args.invocation,
            conversation_name,
            args.parent_conversation,
            file_edit_path,
            file_edit_id,
            provider,
            model,
            args.config,
        )

    token_stats = TokenStats()
    try:
        exit_code, responses = run_agent_loop(
            conversation_file,
            root,
            llm,
            initial_prompt,
            pid,
            file_edit_path,
            file_edit_id,
            json_mode=args.json,
            token_stats=token_stats,
            initial_read_paths=args.read,
        )
    except KeyboardInterrupt:
        record_interrupt(conversation_file)
        print(INTERRUPTED_MESSAGE)
        return 130
    if args.json:
        payload = {
            "exit_code": exit_code,
            "conversation_path": str(conversation_file.resolve()),
            "responses": responses,
            **token_stats.as_dict(),
        }
        payload["tokens_in"] = token_stats.recursive_input_tokens
        payload["tokens_out"] = token_stats.recursive_output_tokens
        emit_json(payload)
    elif user_direct_mode:
        print(token_stats.status_line())
    return exit_code


if __name__ == "__main__":
    sys.exit(main())
