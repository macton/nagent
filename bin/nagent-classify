#!/usr/bin/python3

import argparse
import sys
from pathlib import Path

HELPERS_DIR = Path(__file__).resolve().parent / "helpers"
sys.path.insert(0, str(HELPERS_DIR))
from nagent_llm import (
    add_llm_arguments,
    generate_text_with_usage,
    reasoning_value_from_args,
    resolve_from_args,
)
from nagent_cli import emit_json, exit_on_description
from nagent_classify_lib import (
    EXIT_BAD_REQUEST,
    EXIT_OK,
    EXIT_PROVIDER,
    MAX_ATTEMPTS,
    ClassifyError,
    DecideError,
    classify,
    load_request,
    render_classify_prompt,
)

NAGENT_CLASSIFY_DESCRIPTION = """\
Sort a set of inputs into a closed set of categories: JSON in, JSON out.
Request on stdin or --input:

{"question":    "the dimension you are classifying on",         // REQUIRED
 "categories":  ["name", ...] | {"name": "description", ...},   // REQUIRED, >= 2
 "inputs":      [{"id": "...", "text": <any JSON>}, ...],       // REQUIRED, [] is legal
 "context":     <shared evidence; optional>,
 "constraints": ["rule", ...],                                  // optional
 "multi_label": false, "rationale": true, "confidence": true}   // optional

Note the shapes: "categories" is a list of names or an object mapping name to
description, never a list of objects; each input is {"id", "text"}. Returns
{"classified": [{"input", "category", "categories", "confidence", "why"}, ...],
"buckets": {"category": ["input id", ...]}} — one row per input in request order,
plus the inverse index, in which every declared category is a key even when
nothing was assigned to it. "category" holds the single assignment and is null
when "multi_label" is true; "categories" is always the full assigned list.
"question" is required because a set like {high, medium, low} does not say high
WHAT. A category outside the declared set is rejected and retried, never
accepted, and the shared context is sent once for the whole input set.
Use nagent-decide when several different questions apply to the same items; use
this when one category set applies to many inputs."""

EXAMPLE = """\
Example request (stdin):

{
  "question": "Which lane can actually run this item's proof?",
  "context": "The gate owns the display, the GPU and real clients.",
  "constraints": ["A staging lane has no display, no GPU and no real client."],
  "categories": {
    "gate": "needs the display, the GPU or a real client",
    "staging": "headless, source-level or server-only"
  },
  "inputs": [
    {"id": "#176", "text": "cursor moved quickly while firing drops shots"},
    {"id": "#110", "text": "crew-name relay; reproduces headless, no rendering"}
  ]
}

Output:

{
  "classified": [
    {"input": "#176", "category": "gate", "categories": ["gate"], ...},
    {"input": "#110", "category": "staging", "categories": ["staging"], ...}
  ],
  "buckets": {"gate": ["#176"], "staging": ["#110"]}
}
"""


def main() -> int:
    exit_on_description(NAGENT_CLASSIFY_DESCRIPTION)

    parser = argparse.ArgumentParser(
        description=(
            "Classify inputs into a closed category set. Reads a request as JSON and "
            "prints a category per input, plus the inverse index, as JSON."
        ),
        epilog=EXAMPLE,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--input", help="Path to the request JSON (default: stdin).")
    parser.add_argument(
        "--prompt-out",
        help="Also write the rendered prompt here, so the generator's input is inspectable.",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Validate the request and print the rendered prompt; make no LLM call.",
    )
    parser.add_argument(
        "--attempts",
        type=int,
        default=MAX_ATTEMPTS,
        help=f"Tries allowed before giving up on an unusable reply (default: {MAX_ATTEMPTS}).",
    )
    add_llm_arguments(parser)
    args = parser.parse_args()

    if args.attempts < 1:
        print("Error: --attempts must be >= 1", file=sys.stderr)
        return EXIT_BAD_REQUEST

    if args.input:
        path = Path(args.input).expanduser()
        if not path.is_file():
            print(f"Error: file not found: {path}", file=sys.stderr)
            return EXIT_PROVIDER
        source = path.read_text(encoding="utf-8")
    else:
        source = sys.stdin.read()

    try:
        request = load_request(source)
    except DecideError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return exc.exit_code

    # An empty input set classifies nothing and sends nothing: render no prompt,
    # make no call, and report in the same shape as any other run.
    empty_batch = not request["inputs"]
    prompt = "" if empty_batch else render_classify_prompt(request)[0]

    if args.prompt_out:
        Path(args.prompt_out).expanduser().write_text(prompt, encoding="utf-8")

    if args.dry_run:
        sys.stdout.write(prompt)
        return EXIT_OK

    provider, model = ("none", "none") if empty_batch else resolve_from_args(args)
    reasoning = reasoning_value_from_args(args)

    def generate(text, cache_boundaries):
        return generate_text_with_usage(
            text, provider, model, cache_boundaries=cache_boundaries, reasoning=reasoning
        )

    try:
        result = classify(request, generate, max_attempts=args.attempts)
    except DecideError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return exc.exit_code
    except Exception as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return EXIT_PROVIDER

    emit_json({"provider": provider, "model": model, **result})
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
